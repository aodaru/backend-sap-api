# Backend API - Automatización SAP
# Variables de entorno (copiar a .env y configurar)

# API Keys (separadas por coma)
API_KEYS=mi-api-key-secreta,otra-key

# CORS - Orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:4321,http://localhost:8080,http://localhost:3000

# SAP Configuration
SAP_SYSTEM=PRD
SAP_MANDANT=300
SAP_LANG=ES
SAP_CONNECTION_NAME=
SAP_SESSION_INDEX=0
SAP_INTEGRATION_ENABLED=false

# Cola de peticiones SAP
SAP_EXECUTION_TIMEOUT=120  # Timeout en segundos por ejecución
SAP_QUEUE_WAIT_TIMEOUT=120  # Timeout esperando turno
MAX_QUEUE_SIZE=5           # Máximo de peticiones en cola
MAX_RETRIES=2              # Reintentos en errores transitorios
SAP_RETRY_BACKOFF=1        # Backoff máximo en segundos

# Servidor
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false
